# URL des Adobe-Express-Projekts (aus der Adressleiste kopieren)
ADOBE_EXPRESS_PROJECT_URL=

# Browser sichtbar lassen (empfohlen fuer den ersten Adobe-Login)
HEADLESS=false

# Wartezeit zwischen mehreren Seiten in Sekunden
DELAY_BETWEEN_PINS_SECONDS=20

# true = nur Content anzeigen, nichts veroeffentlichen
DRY_RUN=false
