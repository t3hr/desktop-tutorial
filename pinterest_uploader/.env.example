# Pinterest-Zugangsdaten (nur noetig, wenn keine gespeicherte Browser-Session existiert)
PINTEREST_EMAIL=
PINTEREST_PASSWORD=

# Name des Pinterest-Boards, auf das gepinnt werden soll (muss exakt existieren)
PINTEREST_BOARD_NAME=

# Optionale Ziel-URL, die bei jedem Pin als "Zielwebsite" gesetzt wird
DESTINATION_LINK=

# Ordner mit den hochzuladenden Bildern
UPLOAD_FOLDER=Pinterest-Uploads

# Browser sichtbar lassen (empfohlen fuer den ersten Login / 2FA / Captcha)
HEADLESS=false

# Wartezeit zwischen Pins in Sekunden (reduziert Spam-Erkennungsrisiko)
DELAY_BETWEEN_PINS_SECONDS=45

# true = nur Content generieren und anzeigen, nichts veroeffentlichen
DRY_RUN=false
